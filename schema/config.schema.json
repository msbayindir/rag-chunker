{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ocr": {
      "default": {},
      "type": "object",
      "properties": {
        "engine": {
          "default": "auto",
          "type": "string"
        },
        "pages": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "all",
            "scanned"
          ]
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "stripImages": {
          "default": true,
          "type": "boolean"
        },
        "removeHeaderFooter": {
          "default": true,
          "type": "boolean"
        },
        "minTextChars": {
          "default": 40,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "models": {
      "default": {},
      "type": "object",
      "properties": {
        "vision": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*\\/\\S.*$"
        },
        "structure": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*\\/\\S.*$"
        },
        "context": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*\\/\\S.*$"
        },
        "embedding": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*\\/\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "openai",
              "openai-compatible",
              "openrouter",
              "anthropic",
              "gemini",
              "ollama",
              "mistral"
            ]
          },
          "baseURL": {
            "type": "string",
            "format": "uri"
          },
          "apiKey": {
            "type": "string",
            "minLength": 1
          },
          "apiKeyEnv": {
            "type": "string",
            "minLength": 1
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "contextWindow": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maxContext": {
            "type": "integer",
            "minimum": 2048,
            "maximum": 9007199254740991
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "timeoutMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maxRetries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "additionalProperties": false
      }
    },
    "chunk": {
      "default": {},
      "type": "object",
      "properties": {
        "maxTokens": {
          "default": 512,
          "type": "integer",
          "minimum": 32,
          "maximum": 16384
        },
        "minTokens": {
          "default": 64,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapTokens": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hardBoundaryDepth": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "preserveTables": {
          "default": true,
          "type": "boolean"
        },
        "preserveCode": {
          "default": true,
          "type": "boolean"
        },
        "tokenizer": {
          "default": "o200k",
          "type": "string",
          "enum": [
            "o200k",
            "estimate"
          ]
        }
      },
      "additionalProperties": false
    },
    "context": {
      "default": {},
      "type": "object",
      "properties": {
        "strategy": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "full",
            "hierarchical"
          ]
        },
        "batchSize": {
          "default": 8,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "additionalProperties": false
    },
    "embedding": {
      "default": {},
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://unpkg.com/@msbayindir/rag-chunker@4/schema/config.schema.json",
  "title": "rag-chunker configuration"
}
